#!/usr/bin/env bash
# Cloud-init / user-data for a fresh Ubuntu 24.04 host on ANY provider
# (Contabo, Hetzner, GCP, ...). Installs Docker + the compose plugin, creates a
# key-only `${deploy_user}` with docker + passwordless-sudo access, and (for the
# single-box shared-Traefik topology) pre-creates the external `edge` network.
#
# The GitHub Actions deploy workflow rsyncs each repo's infra files + rendered
# env into /opt/<repo>-infrastructure and runs scripts/deploy.sh over SSH; this
# script stores no secrets and clones nothing. It mirrors scripts/bootstrap-host.sh
# (the manual fallback) so a Terraform-provisioned host and a hand-prepared host
# end up identical.
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update -y
apt-get install -y ca-certificates curl sudo fail2ban
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

# --- Key-only deploy user (docker + passwordless sudo) ----------------------
if ! id -u ${deploy_user} >/dev/null 2>&1; then
  useradd -m -s /bin/bash ${deploy_user}
fi
usermod -aG docker ${deploy_user}
install -d -m 700 -o ${deploy_user} -g ${deploy_user} /home/${deploy_user}/.ssh
cat > /home/${deploy_user}/.ssh/authorized_keys <<'DEPLOY_KEY'
${ssh_public_key}
DEPLOY_KEY
chmod 600 /home/${deploy_user}/.ssh/authorized_keys
chown ${deploy_user}:${deploy_user} /home/${deploy_user}/.ssh/authorized_keys
echo "${deploy_user} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-${deploy_user}
chmod 440 /etc/sudoers.d/90-${deploy_user}

# --- SSH brute-force protection ---------------------------------------------
printf '[sshd]\nenabled = true\nmaxretry = 5\nbantime = 1h\nfindtime = 10m\n' > /etc/fail2ban/jail.d/sshd.local
systemctl enable --now fail2ban

%{ if create_edge_network ~}
# --- Shared reverse-proxy network (single-box EDGE_MODE=shared topology) -----
# The edge Traefik stack and every product stack attach to this external network.
docker network inspect edge >/dev/null 2>&1 || docker network create edge
%{ endif ~}

echo "==> Bootstrap complete for ${deploy_user}. The deploy workflow will rsync files and run scripts/deploy.sh."
